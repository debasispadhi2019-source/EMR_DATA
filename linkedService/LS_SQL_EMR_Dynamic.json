{
	"name": "LS_SQL_EMR_Dynamic",
	"type": "Microsoft.DataFactory/factories/linkedservices",
	"properties": {
		"parameters": {
			"pDatabse": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "AzureSqlDatabase",
		"typeProperties": {
			"server": "emrdbuser.database.windows.net",
			"database": "@{linkedService().pDatabse}",
			"encrypt": "mandatory",
			"trustServerCertificate": false,
			"authenticationType": "SystemAssignedManagedIdentity"
		}
	}
}