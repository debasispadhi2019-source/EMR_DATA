{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "ADF-EMR-HEALTH"
		},
		"LS_ADLS_EMR_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLS_EMR'"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "emrdbuser.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "etl_control"
		},
		"LS_ADLS_EMR_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://saemrhealth.dfs.core.windows.net/"
		},
		"LS_EMT_KEYVALUT_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://emr-secrect-key.vault.azure.net/"
		},
		"LS_SQL_EMR_UPD_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "emrdbuser.database.windows.net"
		},
		"LS_SQL_EMR_UPD_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "@{linkedService().pDatabase}"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "ADF-EMR-HEALTH_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_EMR_accountKey": {
						"value": "[parameters('LS_ADLS_EMR_accountKey')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"LS_ADLS_EMR_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_EMR_properties_typeProperties_url')]"
					},
					"LS_EMT_KEYVALUT_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_EMT_KEYVALUT_properties_typeProperties_baseUrl')]"
					},
					"LS_SQL_EMR_UPD_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_EMR_UPD_properties_typeProperties_server')]"
					},
					"LS_SQL_EMR_UPD_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_EMR_UPD_properties_typeProperties_database')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}