--------Lookup Activity (Query)

SELECT
    h.SourceFolder,
    h.TargetDatabase,
    f.filename AS FileName,
    f.TargetTable,
    'dbo' AS TargetSchema
FROM dbo.HopitalConfig h
CROSS JOIN dbo.fileconfig f
WHERE h.Is_active = 1
  AND f.IsActive = 1
  AND (
       (h.SourceFolder = 'hospi1'
        AND f.filename LIKE '%hospi%1%')
       OR
       (h.SourceFolder = 'hospi2'
        AND f.filename LIKE '%hospi%2%')
  )
ORDER BY h.ConfigID, f.ConfigID;


